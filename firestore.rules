rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate sent audio message data structure
    function isValidAudioMessage() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'userEmail', 'userName', 'fileName', 'url', 'timestamp', 'recordedAt', 'type'])
        && data.userId is string
        && data.userEmail is string
        && data.userName is string
        && data.fileName is string
        && data.url is string
        && data.recordedAt is number
        && data.type == 'sent'
        && data.userId == request.auth.uid  // Ensure userId matches authenticated user
        && data.fileName.split('/').size() == 3
        && data.fileName.split('/')[0] == 'user_recordings'
        && data.fileName.split('/')[1] == request.auth.token.email.split('@').join('_')
        && data.fileName.split('/')[2].matches('green_[0-9]+\\.mp4');  // Validate file path
    }
    
    // Rules for sentAudioMessages collection
    match /sentAudioMessages/{messageId} {
      // Allow read only if the user is the owner of the message
      allow read: if isAuthenticated() && 
                     resource.data.userId == request.auth.uid;
      
      // Allow create only if authenticated, valid data, and user owns the message
      allow create: if isAuthenticated() && 
                       isValidAudioMessage() &&
                       request.resource.data.userId == request.auth.uid;
      
      // Allow update only if user is the owner (in case you need to update metadata later)
      allow update: if isOwner(resource.data.userId) &&
                       request.resource.data.userId == resource.data.userId &&  // Can't change userId
                       request.resource.data.url == resource.data.url &&  // Can't change URL
                       request.resource.data.fileName == resource.data.fileName;  // Can't change fileName
      
      // Allow delete only if user is the owner
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
