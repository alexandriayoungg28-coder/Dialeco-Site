rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Audio Pod progress: doc id is the user's email; each signed-in user
    // can only read and write their own document.
    match /audioPodProgress/{email} {
      allow read, write: if isAuthenticated()
        && request.auth.token.email == email;
    }

    // Student feedback surveys: signed-in users can submit, nobody can read,
    // edit, or delete from the client. Alexandria reads them in the console.
    match /surveys/{surveyId} {
      allow create: if isAuthenticated()
        && request.resource.data.email == request.auth.token.email;
      allow read, update, delete: if false;
    }

    // Legacy collections from the old Express-server era. Data is kept but
    // clients have no access; view in the console if ever needed.
    match /sentAudioMessages/{messageId} {
      allow read, write: if false;
    }
    match /emailVerifications/{docId} {
      allow read, write: if false;
    }

    // Everything else: locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
