rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Signed-in check
    function isAuthenticated() {
      return request.auth != null;
    }

    // The audio-pod page stores recordings under the user's email with @ replaced by _
    function isOwnFolder(userFolder) {
      return isAuthenticated()
        && userFolder == request.auth.token.email.split('@').join('_');
    }

    // Audio files only, capped at 50MB
    function isValidAudioFile() {
      return request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Student recordings: each signed-in user can manage only their own folder.
    // Filenames the site actually generates: sent-<timestamp>.m4a (Safari) or .webm (Chrome).
    match /user_recordings/{userFolder}/{audioFile} {
      allow read, delete: if isOwnFolder(userFolder);
      allow write: if isOwnFolder(userFolder)
        && isValidAudioFile()
        && audioFile.matches('sent-[0-9]+\\.(m4a|webm)');
    }

    // Course content (the prerecorded conversation audio): readable by anyone,
    // writable only from the Firebase console / admin tooling.
    match /prerecorded-audio/{audioFile} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else: locked.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
